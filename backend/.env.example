# Copy this file to .env and fill in your values

# From your Salesforce External Client App (Connected App)
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here

# Must exactly match the Callback URL set in the External Client App
SF_REDIRECT_URI=http://localhost:5000/auth/callback

# Use https://login.salesforce.com for prod/dev-hub orgs,
# or https://test.salesforce.com for sandboxes
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce REST API version
SF_API_VERSION=v61.0

# Any random long string, used to sign the session cookie
SESSION_SECRET=change_this_to_a_random_string

# URL where your React frontend runs (for CORS + redirect after login)
FRONTEND_URL=http://localhost:5174

PORT=5000
